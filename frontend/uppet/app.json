{
  "expo": {
    "name": "uppet",
    "slug": "uppet",
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SplashScreen-green.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uppet.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.uppet.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#A8E6CF",
        "foregroundImage": "./assets/images/SplashScreen-white.png",
        "monochromeImage": "./assets/images/SplashScreen-white.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SplashScreen-white.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#A8E6CF"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.6734110788-9lbc61k9u8dg4tebk8uppo4ve75ju28b"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c917b7d-380c-4942-90fe-93ba7747b38b"
      }
    }
  }
}
